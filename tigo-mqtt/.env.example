# MQTT Broker Configuration
# Copy this to .env and fill in values, or generate via the setup wizard.

MQTT_SERVER=<MQTT_BROKER_HOST>     # e.g. mqtt.example.lan or a private LAN IP
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# Static MQTT client ID — set per-service in docker-compose.yml under
# `environment:` (e.g. MQTT_CLIENT_ID=taptap-primary), NOT here. Each service
# needs its own unique value, so a shared env_file is the wrong place.
# If unset, paho auto-generates a random ID (broker logs not searchable).

# Timezone for log timestamps and energy reset boundaries
TZ=America/New_York

# Watchdog manual-bounce shared secret. REQUIRED if the taptap-watchdog
# service is enabled. Generate with: openssl rand -hex 32
# This must match the `tigo_bounce_token` in HA's secrets.yaml so the
# dashboard bounce buttons can authenticate.
BOUNCE_TOKEN=replace-with-output-of-openssl-rand-hex-32
