# Append these entries to HA's secrets.yaml (FR-4.7).
#
# Substitute:
#   <PI_HOST>        — LAN IP/hostname of the Pi running tigo-mqtt
#                      (from .claude/env's PI_HOST)
#   <BOUNCE_TOKEN>   — value of BOUNCE_TOKEN from tigo-mqtt/.env on the Pi
#                      (output of `openssl rand -hex 32`, at least 32 bytes)
#   <NOTIFY_SERVICE> — operator's mobile_app entity, e.g. mobile_app_iphone
#                      (discover via `python3 dashboards/scripts/query_entities.py --filter mobile_app`)
#
# secrets.yaml is NEVER committed to a public repo if it contains real
# credentials. The watchdog's BOUNCE_TOKEN is a shared secret between the Pi
# and HA — leaking it would let any LAN device bounce the taptap containers.

tigo_bounce_primary_url:   "http://<PI_HOST>:8080/bounce/primary"
tigo_bounce_secondary_url: "http://<PI_HOST>:8080/bounce/secondary"
tigo_bounce_token:         "<BOUNCE_TOKEN>"
tigo_notify_service:       "<NOTIFY_SERVICE>"   # optional; only used if you templatize automations.yaml
